<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<!-- can a customer sign in, find a product, and buy it? Runs in roughly a
     quarter of the time of the full suite. -->
<suite name="SauceDemo smoke" parallel="classes" thread-count="3" verbose="1">

    <listeners>
        <listener class-name="com.ore.saucedemo.listeners.TestListener"/>
        <listener class-name="com.ore.saucedemo.listeners.RetryTransformer"/>
    </listeners>

    <test name="Smoke">
        <groups>
            <run>
                <include name="smoke"/>
            </run>
        </groups>
        <classes>
            <class name="com.ore.saucedemo.tests.LoginTests"/>
            <class name="com.ore.saucedemo.tests.InventoryTests"/>
            <class name="com.ore.saucedemo.tests.CartTests"/>
            <class name="com.ore.saucedemo.tests.CheckoutTests"/>
        </classes>
    </test>
</suite>
